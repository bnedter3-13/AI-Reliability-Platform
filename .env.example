# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Required — the Claude judge used by Core Evaluation, AI Analysis Agent,
# Recommendation Engine, Prompt Evaluation, and RAG Evaluation (and as a
# comparison model in Model Comparison). Get one from the Anthropic Console.
ANTHROPIC_API_KEY=your-api-key-here

# Optional — only needed for Model Comparison (Component 8) if you want to
# include GPT-4o / GPT-4o-mini as comparison targets alongside Claude.
OPENAI_API_KEY=your-openai-api-key-here

# Optional — only needed for Model Comparison (Component 8) if you want to
# include Gemini models as comparison targets alongside Claude.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — only needed for Model Comparison (Component 8) if you want to
# include Qwen models as comparison targets. This is an OpenRouter
# (openrouter.ai) API key, not a Qwen/Alibaba key directly — Qwen is accessed
# through OpenRouter's OpenAI-compatible API.
QWEN_API_KEY=your-openrouter-api-key-here

# Database connection string.
# Local dev default (SQLite, no setup needed):
DATABASE_URL=sqlite:///./ai_reliability.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_reliability

# Drift Detection (Component 6) sensitivity: fraction drop in average
# faithfulness (0-1) between the recent and previous time windows that
# triggers a drift alert.
DRIFT_ALERT_THRESHOLD=0.15
