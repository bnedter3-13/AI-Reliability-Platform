# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Required — get one from the Anthropic Console
ANTHROPIC_API_KEY=your-api-key-here

# Database connection string.
# Local dev default (SQLite, no setup needed):
DATABASE_URL=sqlite:///./ai_reliability.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_reliability

# Drift detection sensitivity (0-1, fraction drop that triggers an alert)
DRIFT_ALERT_THRESHOLD=0.15
